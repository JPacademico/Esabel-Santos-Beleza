# Public frontend configuration. Copy to `.env.local` and fill in.
# All three values are safe to expose in a browser bundle.
# Get the first two from: Supabase Dashboard → Project Settings → API.

VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-public-key>"

# Same VAPID PUBLIC key you set on the backend (never the private one).
VITE_VAPID_PUBLIC_KEY="<vapid-public-key>"
